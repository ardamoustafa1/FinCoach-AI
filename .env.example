# Frontend-only public environment variables.
# Keep Gemini and Supabase service-role keys in server/.env only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_API_URL=http://localhost:3001

# Optional public demo-login values. Do not use real user credentials here.
VITE_DEMO_EMAIL=demo@fincoach.app
VITE_DEMO_PASSWORD=Demo2026!

# --- Server/Backend Environment Variables ---
# Copy these to server/.env and fill in the values for production.
PORT=3001
HOST=0.0.0.0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_PRIMARY_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=30000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
WHATSAPP_ENABLED=false
# Kimlik doğrulamayı atlar; SADECE yerel geliştirme ve e2e testleri için.
# Üretimde asla 'true' yapmayın.
DEMO_MODE=false
REDIS_URL=redis://localhost:6379
