PORT=3001
GEMINI_API_KEY=your_gemini_api_key

# Required for WhatsApp receipt/text messages to be saved into Supabase.
# Use the server-only service role key. Never expose this key in Vite/client env files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: public demo credentials used by npm run seed:demo.
DEMO_EMAIL=demo@butceai.app
DEMO_PASSWORD=Demo2026!

# Optional: save every WhatsApp message to one app user when sender phone matching is not desired.
# WHATSAPP_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Optional controls
WHATSAPP_ENABLED=true
WHATSAPP_ALLOW_GROUPS=false
WHATSAPP_PROCESS_OWN_MESSAGES=true
